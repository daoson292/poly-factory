{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "CommonJS",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../frontend/node_modules/@types/react"],
      "react/*": ["../frontend/node_modules/@types/react/*"],
      "react/jsx-runtime": ["../frontend/node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["src"]
}
